# ============================================================================
# NEXORA ENVIRONMENT CONFIGURATION (.env.example)
# Fill in real values in your server-side environment / deployment settings.
# ============================================================================

# 1. Google Gemini AI API Key (Server-Side Only)
# Used exclusively inside server.ts for Gemini 3.8 Flash inference.
# Never expose this key in client-side bundles or frontend code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Supabase Configuration (Authentication, PostgreSQL Database & Storage)
# The public URL for your Supabase project (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# The Supabase public anonymous API key (safe for browser bundles)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# The Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used inside server.ts for privileged administrative queries and token verification.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# 3. Application Hosting
PORT=3000
APP_URL="https://YOUR_APPLET_URL.run.app"
NODE_ENV="production"
